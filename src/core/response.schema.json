{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "basis",
    "basisReason",
    "containment",
    "accessActive",
    "encryption",
    "noticeLanguages",
    "childrenCount",
    "disabilityCount",
    "guardianRecipients",
    "jointFiduciaries",
    "exemptionAssessment",
    "reviewerRole",
    "reviewedAt",
    "reviewNote",
    "actions",
    "history",
    "practice",
    "discoveredAt",
    "containmentStartedAt",
    "preparationStartedAt"
  ],
  "properties": {
    "basis": {
      "enum": [
        "",
        "fiduciary",
        "processor",
        "earliest"
      ]
    },
    "basisReason": {
      "type": "string"
    },
    "containment": {
      "enum": [
        "unknown",
        "active",
        "contained"
      ]
    },
    "accessActive": {
      "enum": [
        "unknown",
        "yes",
        "no"
      ]
    },
    "encryption": {
      "enum": [
        "unknown",
        "encrypted",
        "not_encrypted"
      ]
    },
    "noticeLanguages": {
      "type": "string"
    },
    "childrenCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "disabilityCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "guardianRecipients": {
      "enum": [
        "unknown",
        "principals",
        "guardians",
        "both"
      ]
    },
    "jointFiduciaries": {
      "enum": [
        "unknown",
        "yes",
        "no"
      ]
    },
    "exemptionAssessment": {
      "type": "string"
    },
    "reviewerRole": {
      "type": "string"
    },
    "reviewedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewNote": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "ownerRole",
          "status",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "ownerRole": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "done"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "description"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "practice": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "scenario",
        "step",
        "startedAt"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "discoveredAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "containmentStartedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "preparationStartedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
